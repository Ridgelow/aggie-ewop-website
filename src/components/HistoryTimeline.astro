---
import { historyMilestones } from '../data/content';

const dotColor: Record<string, string> = {
  rose: 'bg-rose',
  violet: 'bg-violet',
  sky: 'bg-sky',
};

const yearColor: Record<string, string> = {
  rose: 'text-rose',
  violet: 'text-violet',
  sky: 'text-sky',
};
---

<div class="mx-auto max-w-3xl">
  {
    historyMilestones.map((step, i) => (
      <div class="grid grid-cols-[88px_28px_1fr] gap-x-4 md:grid-cols-[110px_32px_1fr] md:gap-x-5">
        <div class={`pt-0.5 text-right font-display text-lg font-extrabold leading-none md:text-xl ${yearColor[step.color]}`}>
          {step.year}
        </div>

        <div class="flex flex-col items-center">
          <span class={`mt-1 block h-3.5 w-3.5 shrink-0 rounded-full ring-4 ring-pink-wash-1 ${dotColor[step.color]}`} />
          {i < historyMilestones.length - 1 && (
            <span class="mt-1 w-0.5 flex-1 bg-line" />
          )}
        </div>

        <div class={`pb-10 ${i === historyMilestones.length - 1 ? 'pb-0' : ''}`}>
          <h3 class="font-display text-lg font-semibold text-ink md:text-xl">{step.title}</h3>
          <p class="mt-1.5 font-body text-sm leading-relaxed text-muted">{step.detail}</p>
          {'image' in step && step.image && (
            <div class="mt-4 overflow-hidden rounded-2xl shadow-lg shadow-ink/10">
              <img
                src={step.image}
                alt={step.title}
                class="h-44 w-full object-cover md:h-56"
                loading="lazy"
              />
            </div>
          )}
        </div>
      </div>
    ))
  }
</div>
