---
import type { Pillar } from '../data/pillars';

export interface Props {
  pillar: Pillar;
}

const { pillar } = Astro.props;

// Tailwind needs full class strings (not built dynamically) to pick them up
// at build time, so each pillar accent color gets an explicit entry here.
const styles: Record<Pillar['color'], { bar: string; tile: string; text: string }> = {
  rose: { bar: 'bg-rose', tile: 'bg-rose-tint', text: 'text-rose' },
  sky: { bar: 'bg-sky', tile: 'bg-sky-tint', text: 'text-sky' },
  violet: { bar: 'bg-violet', tile: 'bg-violet-tint', text: 'text-violet' },
  fundraising: { bar: 'bg-fundraising', tile: 'bg-fundraising-tint', text: 'text-fundraising' },
};

const s = styles[pillar.color];
---

<a
  href={`/pillars#${pillar.slug}`}
  class="group flex h-full flex-col gap-3 rounded-2xl bg-white p-6 pt-0 shadow-sm transition-all hover:-translate-y-1.5 hover:shadow-xl hover:shadow-ink/10"
>
  <div class={`-mx-6 mb-1 h-1 rounded-t-2xl ${s.bar}`}></div>
  <div class={`flex h-11 w-11 items-center justify-center rounded-xl ${s.tile}`}>
    <span class={`font-display text-sm font-extrabold ${s.text}`}>{pillar.monogram}</span>
  </div>
  <h3 class="font-display text-xl font-semibold text-ink">{pillar.name}</h3>
  <p class="line-clamp-3 font-body text-sm leading-relaxed text-muted">{pillar.summary}</p>
</a>
