---
import { stats } from '../data/content';
---

<section class="bg-gradient-to-br from-ink to-ink2 px-6 py-16 md:px-24 md:py-20">
  <div class="reveal-stagger grid grid-cols-2 gap-8 md:grid-cols-4 md:gap-10">
    {
      stats.map((stat, i) => (
        <div class="flex flex-col gap-2" style={`--i: ${i}`}>
          <span class="font-display text-3xl font-extrabold text-white md:text-[42px]">{stat.value}</span>
          <span class="font-body text-sm leading-relaxed text-[#D8CFDE]">{stat.label}</span>
        </div>
      ))
    }
  </div>
</section>
