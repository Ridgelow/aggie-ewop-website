---
import { links } from '../data/links';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Our Team' },
  { href: '/pillars', label: 'Pillars' },
  { href: '/get-involved', label: 'Get Involved' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-[60] border-b border-line bg-white/95 backdrop-blur-md">
  <nav class="relative flex h-16 items-center justify-between px-5 sm:h-20 sm:px-6 md:h-24 md:px-24">
    <a href="/" class="shrink-0">
      <img src="/images/logo.jpg" alt="Aggie EWOP" class="h-10 w-auto sm:h-12 md:h-14" />
    </a>

    <div class="hidden items-center gap-9 lg:flex">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'group relative pb-2 font-body text-sm font-semibold',
                isActive ? 'text-ink' : 'text-muted hover:text-ink',
              ]}
            >
              {item.label}
              <span
                class:list={[
                  'absolute -bottom-0.5 left-0 right-0 h-0.5 origin-left scale-x-0 rounded bg-brand transition-transform duration-300 group-hover:scale-x-100',
                  isActive && 'scale-x-100',
                ]}
              />
            </a>
          );
        })
      }
    </div>

    <div class="flex items-center gap-3">
      <a
        href={links.applicationUrl}
        data-apply-cta
        class="hidden rounded-lg bg-brand px-4 py-2 font-body text-sm font-bold text-white transition-transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-rose/30 sm:inline-block md:px-5 md:py-2.5"
      >
        Apply Now
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="relative z-[70] flex h-10 w-10 items-center justify-center rounded-lg border border-line text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span id="nav-icon-open" class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="block h-0.5 w-5 rounded-full bg-ink"></span>
          <span class="block h-0.5 w-5 rounded-full bg-ink"></span>
          <span class="block h-0.5 w-5 rounded-full bg-ink"></span>
        </span>
        <span id="nav-icon-close" class="hidden font-display text-2xl leading-none text-ink" aria-hidden="true">×</span>
      </button>
    </div>
  </nav>
</header>

<!-- Fixed to the viewport (moved to body in JS) so it works at any scroll position -->
<div
  id="mobile-nav"
  class="fixed inset-0 z-[55] hidden lg:hidden"
  hidden
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <button type="button" data-nav-backdrop class="absolute inset-0 bg-ink/40" aria-label="Close menu"></button>
  <div class="absolute inset-x-0 top-16 flex max-h-[calc(100dvh-4rem)] flex-col overflow-y-auto border-b border-line bg-white shadow-xl sm:top-20 md:top-24 md:max-h-[calc(100dvh-6rem)]">
    <div class="flex flex-col gap-1 px-5 py-4">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-xl px-4 py-3 font-body text-base font-semibold',
                isActive ? 'bg-rose-tint text-rose' : 'text-ink hover:bg-pink-wash-1',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href={links.applicationUrl}
        data-apply-cta
        class="mt-2 rounded-lg bg-brand px-4 py-3 text-center font-body text-sm font-bold text-white"
      >
        Apply Now
      </a>
    </div>
  </div>
</div>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggle && panel && iconOpen && iconClose) {
    // Keep the overlay on <body> so no ancestor overflow/transform can clip it
    if (panel.parentElement !== document.body) {
      document.body.appendChild(panel);
    }

    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.classList.toggle('hidden', !open);
      panel.hidden = !open;
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      document.documentElement.classList.toggle('overflow-hidden', open);
      document.body.classList.toggle('overflow-hidden', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a, [data-nav-backdrop]').forEach((el) => {
      el.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') setOpen(false);
    });
  }
</script>
