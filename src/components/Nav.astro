---
import { links } from '../data/links';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Our Team' },
  { href: '/pillars', label: 'Pillars' },
  { href: '/get-involved', label: 'Get Involved' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur-md">
  <nav class="relative flex h-16 items-center justify-between px-5 sm:h-20 sm:px-6 md:h-24 md:px-24">
    <a href="/" class="relative z-10 shrink-0">
      <img src="/images/logo.jpg" alt="Aggie EWOP" class="h-10 w-auto sm:h-12 md:h-14" />
    </a>

    <div class="hidden items-center gap-9 lg:flex">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'group relative pb-2 font-body text-sm font-semibold',
                isActive ? 'text-ink' : 'text-muted hover:text-ink',
              ]}
            >
              {item.label}
              <span
                class:list={[
                  'absolute -bottom-0.5 left-0 right-0 h-0.5 origin-left scale-x-0 rounded bg-brand transition-transform duration-300 group-hover:scale-x-100',
                  isActive && 'scale-x-100',
                ]}
              />
            </a>
          );
        })
      }
    </div>

    <div class="relative z-10 flex items-center gap-3">
      <a
        href={links.applicationUrl}
        data-apply-cta
        class="hidden rounded-lg bg-brand px-4 py-2 font-body text-sm font-bold text-white transition-transform hover:-translate-y-0.5 hover:shadow-lg hover:shadow-rose/30 sm:inline-block md:px-5 md:py-2.5"
      >
        Apply Now
      </a>

      <button
        type="button"
        id="nav-toggle"
        class="flex h-10 w-10 items-center justify-center rounded-lg border border-line text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span id="nav-icon-open" class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="block h-0.5 w-5 rounded-full bg-ink"></span>
          <span class="block h-0.5 w-5 rounded-full bg-ink"></span>
          <span class="block h-0.5 w-5 rounded-full bg-ink"></span>
        </span>
        <span id="nav-icon-close" class="hidden font-display text-2xl leading-none text-ink" aria-hidden="true">×</span>
      </button>
    </div>
  </nav>

  <div
    id="mobile-nav"
    class="hidden border-t border-line bg-white lg:hidden"
    hidden
  >
    <div class="flex flex-col gap-1 px-5 py-4">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-xl px-4 py-3 font-body text-base font-semibold',
                isActive ? 'bg-rose-tint text-rose' : 'text-ink hover:bg-pink-wash-1',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <a
        href={links.applicationUrl}
        data-apply-cta
        class="mt-2 rounded-lg bg-brand px-4 py-3 text-center font-body text-sm font-bold text-white"
      >
        Apply Now
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  if (toggle && panel && iconOpen && iconClose) {
    const setOpen = (open) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.classList.toggle('hidden', !open);
      panel.hidden = !open;
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
      document.body.classList.toggle('overflow-hidden', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });
  }
</script>
