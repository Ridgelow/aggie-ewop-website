---
import { links } from '../data/links';

const navItems = [
  { href: '/about', label: 'About' },
  { href: '/team', label: 'Our Team' },
  { href: '/pillars', label: 'Pillars' },
  { href: '/get-involved', label: 'Get Involved' },
];
---

<footer class="flex flex-col bg-ink">
  <div class="h-1 bg-brand"></div>
  <div class="flex flex-col gap-10 px-6 py-14 md:flex-row md:items-start md:justify-between md:px-24 md:py-16">
    <div class="flex max-w-xs flex-col gap-4">
      <div class="w-fit rounded-xl bg-white p-2.5">
        <img src="/images/logo.jpg" alt="Aggie EWOP" class="h-12 w-auto" />
      </div>
      <p class="font-body text-sm leading-relaxed text-[#C9C2CE]">
        A Texas A&amp;M student organization supporting women's reentry through business education.
      </p>
    </div>

    <div class="flex flex-col gap-2.5">
      <span class="font-body text-xs font-bold uppercase tracking-widest text-faint">Site</span>
      {navItems.map((item) => <a href={item.href} class="font-body text-sm text-[#EDE9ED] hover:text-white">{item.label}</a>)}
    </div>

    <div class="flex flex-col gap-2.5">
      <span class="font-body text-xs font-bold uppercase tracking-widest text-faint">Contact</span>
      <a href={`mailto:${links.email}`} class="font-body text-sm text-[#EDE9ED] hover:text-white">{links.email}</a>
      <a href={links.instagramUrl} class="font-body text-sm text-[#EDE9ED] hover:text-white">{links.instagramHandle}</a>
    </div>

    <div class="flex flex-col gap-2.5">
      <span class="font-body text-xs font-bold uppercase tracking-widest text-faint">Follow</span>
      <div class="flex gap-2.5">
        <a
          href={links.instagramUrl}
          aria-label="Aggie EWOP on Instagram"
          class="flex h-[38px] w-[38px] items-center justify-center rounded-full border border-white/25 text-[#EDE9ED] transition-colors hover:border-white/60 hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4.2"></circle>
            <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
        <a
          href={links.linkedinUrl}
          aria-label="Aggie EWOP on LinkedIn"
          class="flex h-[38px] w-[38px] items-center justify-center rounded-full border border-white/25 text-[#EDE9ED] transition-colors hover:border-white/60 hover:text-white"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="4"></rect>
            <line x1="7.5" y1="10" x2="7.5" y2="17"></line>
            <circle cx="7.5" cy="6.7" r="0.9" fill="currentColor" stroke="none"></circle>
            <path d="M11.5 17v-4.2c0-1.6 1-2.6 2.4-2.6 1.3 0 2.1.9 2.1 2.6V17"></path>
            <line x1="11.5" y1="10" x2="11.5" y2="17"></line>
          </svg>
        </a>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10 px-6 py-6 md:px-24">
    <p class="font-body text-xs text-faint">© {new Date().getFullYear()} Aggie EWOP · Texas A&amp;M student organization</p>
  </div>
</footer>
