---
import type { Person } from '../data/team';
import { pillars } from '../data/pillars';

export interface Props {
  person: Person;
}

const { person } = Astro.props;

const initials = person.name
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();

const pillar = pillars.find((p) => p.slug === person.pillarSlug);

const avatarBg: Record<string, string> = {
  rose: 'bg-rose',
  sky: 'bg-sky',
  violet: 'bg-violet',
  fundraising: 'bg-fundraising',
};
const textColor: Record<string, string> = {
  rose: 'text-rose',
  sky: 'text-sky',
  violet: 'text-violet',
  fundraising: 'text-fundraising',
};

const accentBg = pillar ? avatarBg[pillar.color] : 'bg-ink';
const accentText = pillar ? textColor[pillar.color] : 'text-ink';

const meta = [person.hometown, person.year, person.major].filter(Boolean).join(' · ');
---

<article class="flex h-full flex-col overflow-hidden rounded-2xl border border-line bg-white transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-ink/10">
  <div class={`relative aspect-[4/5] w-full overflow-hidden ${accentBg}`}>
    <div class="absolute inset-0 flex items-center justify-center font-display text-4xl font-extrabold text-white/90">
      {initials}
    </div>
    {person.photo && (
      <img
        src={person.photo}
        alt={person.name}
        class="absolute inset-0 h-full w-full object-cover object-top"
        onerror="this.remove()"
        loading="lazy"
      />
    )}
  </div>
  <div class="flex flex-1 flex-col gap-2 p-5 md:p-6">
    <div>
      <h3 class="font-display text-xl font-bold text-ink md:text-2xl">{person.name}</h3>
      <div class={`mt-1 font-body text-sm font-semibold ${accentText}`}>{person.role}</div>
    </div>
    {meta && <p class="font-body text-sm leading-relaxed text-muted">{meta}</p>}
    {person.funFact && (
      <p class="font-body text-sm italic leading-relaxed text-faint">{person.funFact}</p>
    )}
  </div>
</article>
