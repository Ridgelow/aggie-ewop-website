---
export interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
  /** Marks this as an application CTA (shows closed modal when applications are shut). */
  applyCta?: boolean;
}

const { href, variant = 'primary', class: className = '', applyCta = false } = Astro.props;

const base = 'inline-block rounded-lg px-6 py-3 text-center font-body text-sm font-bold transition-all';
const styles = {
  primary: 'bg-brand text-white hover:-translate-y-0.5 hover:shadow-lg hover:shadow-rose/30',
  secondary: 'border-2 border-ink text-ink hover:bg-ink hover:text-white',
};
---

<a href={href} class={`${base} ${styles[variant]} ${className}`} {...(applyCta ? { 'data-apply-cta': '' } : {})}>
  <slot />
</a>
