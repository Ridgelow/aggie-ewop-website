---
import { missionQuote } from '../data/content';
---

<section class="reveal relative overflow-hidden px-6 py-16 text-center sm:py-20 md:px-24 md:py-28 lg:px-40">
  <span
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-2 -translate-x-1/2 bg-brand bg-clip-text font-accent text-[100px] leading-none text-transparent opacity-10 sm:top-4 sm:text-[140px] md:top-6 md:text-[180px]"
    >&ldquo;</span
  >
  <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-5 sm:gap-6">
    <div class="h-1 w-16 rounded-full bg-brand"></div>
    <p class="font-accent text-xl italic leading-relaxed text-ink sm:text-2xl md:text-[32px]">
      {missionQuote}
    </p>
    <span class="font-body text-sm font-semibold text-faint">— Aggie EWOP</span>
  </div>
</section>
