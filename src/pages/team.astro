---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCard from '../components/TeamCard.astro';
import { directors, coChairs, facultyAdvisor } from '../data/team';
---

<BaseLayout title="Our Team" description="Meet the Aggie EWOP executive team.">
  <section class="reveal flex max-w-3xl flex-col gap-4 px-6 pb-8 pt-16 md:px-24 md:pt-20">
    <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Meet the team</span>
    <h1 class="font-display text-4xl font-extrabold leading-tight text-ink md:text-5xl">The execs behind Aggie EWOP</h1>
  </section>

  <section class="reveal px-6 pb-10 md:px-24">
    <h2 class="mb-5 font-display text-2xl font-bold text-ink">Directors</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {directors.map((person) => <TeamCard person={person} />)}
    </div>
  </section>

  <section class="reveal bg-gradient-to-b from-pink-wash-1 to-pink-wash-2 px-6 py-10 md:px-24 md:py-12">
    <h2 class="mb-5 font-display text-2xl font-bold text-ink">Co-chairs</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 xl:grid-cols-4">
      {coChairs.map((person) => <TeamCard person={person} />)}
    </div>
  </section>

  <section class="reveal grid grid-cols-1 items-center gap-8 px-6 py-12 md:grid-cols-[220px_1fr] md:gap-10 md:px-24 md:py-16">
    <img
      src={facultyAdvisor.photo}
      alt={facultyAdvisor.name}
      class="h-40 w-40 rounded-full object-cover shadow-xl shadow-ink/10 md:h-[220px] md:w-[220px]"
      onerror="this.style.display='none'"
    />
    <div class="flex flex-col gap-2.5">
      <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Faculty advisor</span>
      <h2 class="font-display text-2xl font-bold text-ink md:text-[28px]">{facultyAdvisor.name}</h2>
      <p class="font-body text-base leading-relaxed text-muted">{facultyAdvisor.role}</p>
    </div>
  </section>
</BaseLayout>
