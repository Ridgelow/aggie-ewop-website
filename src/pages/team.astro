---
import BaseLayout from '../layouts/BaseLayout.astro';
import TeamCard from '../components/TeamCard.astro';
import { directors, coChairs, facultyAdvisor } from '../data/team';
import { pillars } from '../data/pillars';

const headingColor: Record<string, string> = {
  rose: 'text-rose',
  sky: 'text-sky',
  violet: 'text-violet',
  fundraising: 'text-fundraising',
};
---

<BaseLayout title="Our Team" description="Meet the Aggie EWOP executive team.">
  <section class="animate-fadeUp flex max-w-3xl flex-col gap-4 px-6 pb-10 pt-16 md:px-24 md:pt-24">
    <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Meet the team</span>
    <h1 class="font-display text-4xl font-extrabold leading-tight text-ink md:text-5xl">The execs behind Aggie EWOP</h1>
  </section>

  <section class="animate-fadeUp grid grid-cols-1 gap-5 px-6 pb-16 sm:grid-cols-2 md:grid-cols-4 md:px-24">
    {directors.map((person) => <TeamCard person={person} />)}
  </section>

  <section class="animate-fadeUp flex flex-col gap-11 bg-gradient-to-b from-pink-wash-1 to-pink-wash-2 px-6 py-14 md:px-24 md:py-16">
    {
      pillars.map((pillar) => {
        const members = coChairs.filter((c) => c.pillarSlug === pillar.slug);
        if (members.length === 0) return null;
        return (
          <div class="flex flex-col gap-5">
            <h2 class={`font-display text-xl font-bold ${headingColor[pillar.color]}`}>
              {pillar.name} co-chair{members.length > 1 ? 's' : ''}
            </h2>
            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 md:grid-cols-4">
              {members.map((person) => <TeamCard person={person} />)}
            </div>
          </div>
        );
      })
    }
  </section>

  <section class="animate-fadeUp grid grid-cols-1 items-center gap-8 px-6 py-16 md:grid-cols-[160px_1fr] md:gap-8 md:px-24 md:py-20">
    <img
      src={facultyAdvisor.photo}
      alt={facultyAdvisor.name}
      class="h-32 w-32 rounded-full object-cover shadow-xl shadow-ink/10 md:h-40 md:w-40"
      onerror="this.style.display='none'"
    />
    <div class="flex flex-col gap-2">
      <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Faculty advisor</span>
      <h2 class="font-display text-2xl font-bold text-ink">{facultyAdvisor.name}</h2>
      <p class="font-body text-[15px] text-muted">{facultyAdvisor.role}</p>
    </div>
  </section>
</BaseLayout>
