---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatBand from '../components/StatBand.astro';
import HistoryTimeline from '../components/HistoryTimeline.astro';
import { facultyAdvisor } from '../data/team';

const programSteps = [
  {
    n: '01',
    color: 'rose',
    border: 'border-rose',
    title: 'Purpose & leadership',
    detail: 'Character, communication, and personal accountability inside the unit.',
  },
  {
    n: '02',
    color: 'violet',
    border: 'border-violet',
    title: 'Business plan & pitch',
    detail: 'College-level entrepreneurship ending in a shark-tank style presentation.',
  },
  {
    n: '03',
    color: 'sky',
    border: 'border-sky',
    title: 'Graduation',
    detail: 'A ceremony that honors the year of growth — and prepares women for release.',
  },
  {
    n: '04',
    color: 'fundraising',
    border: 'border-fundraising',
    title: 'Life after release',
    detail: 'Housing, work, mentorship, and alumni community when it matters most.',
  },
] as const;

const stepLabel: Record<string, string> = {
  rose: 'text-rose',
  violet: 'text-violet',
  sky: 'text-sky',
  fundraising: 'text-fundraising',
};
---

<BaseLayout title="About" description="What Aggie EWOP is, who qualifies for the program, and our history.">
  <!-- 1. About intro -->
  <section
    data-hero
    class="grid grid-cols-1 items-center gap-10 px-6 pb-16 pt-16 md:grid-cols-[1fr_1.05fr] md:gap-14 md:px-24 md:pb-20 md:pt-24"
  >
    <div class="flex flex-col gap-6">
      <div class="flex flex-col gap-3">
        <span class="reveal font-body text-sm font-bold uppercase tracking-widest text-rose">About</span>
        <h1 class="reveal font-display text-4xl font-extrabold leading-tight text-ink md:text-5xl" style="--reveal-delay: 80ms">
          What is EWOP?
        </h1>
        <p class="reveal max-w-md font-body text-lg leading-relaxed text-muted" style="--reveal-delay: 160ms">
          A Texas nonprofit helping incarcerated women prepare for life after prison — through leadership,
          entrepreneurship, and lasting reentry support.
        </p>
      </div>

      <div class="reveal-stagger flex flex-col gap-5 border-l-2 border-line pl-5" style="--stagger-base: 200ms">
        <div class="flex flex-col gap-1" style="--i: 0">
          <span class="font-display text-base font-bold text-rose">Inside the unit</span>
          <p class="font-body text-sm leading-relaxed text-muted">
            Leadership, character, and a written business plan before release.
          </p>
        </div>
        <div class="flex flex-col gap-1" style="--i: 1">
          <span class="font-display text-base font-bold text-violet">Beyond the gates</span>
          <p class="font-body text-sm leading-relaxed text-muted">
            Mentorship, employment connections, and a community that stays.
          </p>
        </div>
        <div class="flex flex-col gap-1" style="--i: 2">
          <span class="font-display text-base font-bold text-sky">Aggie EWOP · est. 2025</span>
          <p class="font-body text-sm leading-relaxed text-muted">
            Texas A&amp;M’s student chapter — four pillars supporting the women of EWOP.
          </p>
        </div>
      </div>
    </div>

    <div class="reveal-right relative overflow-hidden" style="--reveal-delay: 140ms">
      <div class="pointer-events-none absolute -right-6 -top-6 h-48 w-48 rounded-full bg-brand opacity-25 blur-[50px] sm:-right-8 sm:-top-8 sm:h-56 sm:w-56 sm:opacity-30 sm:blur-[60px]"></div>
      <div class="relative overflow-hidden rounded-2xl shadow-xl shadow-ink/15 sm:rounded-3xl sm:shadow-2xl">
        <img
          src="/images/program-session.jpg"
          alt="EWOP program session"
          class="h-64 w-full object-cover sm:h-72 md:h-[420px]"
        />
      </div>
    </div>
  </section>

  <!-- 2. Program process -->
  <section class="bg-gradient-to-b from-pink-wash-1 to-pink-wash-2 px-6 py-16 md:px-24 md:py-24">
    <div class="reveal mb-10 flex max-w-2xl flex-col gap-3">
      <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">The program</span>
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">How transformation unfolds</h2>
      <p class="font-body text-base leading-relaxed text-muted">
        From the first session inside the unit to life after release, the year is built so women leave with a plan
        — and a community behind them.
      </p>
    </div>
    <div class="reveal-stagger grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        programSteps.map((step, i) => (
          <div class={`flex flex-col gap-2 border-l-2 pl-4 ${step.border}`} style={`--i: ${i}`}>
            <span class={`font-display text-xs font-extrabold uppercase tracking-widest ${stepLabel[step.color]}`}>
              {step.n}
            </span>
            <h3 class="font-display text-lg font-semibold text-ink">{step.title}</h3>
            <p class="font-body text-sm leading-relaxed text-muted">{step.detail}</p>
          </div>
        ))
      }
    </div>
  </section>

  <div class="reveal">
    <StatBand />
  </div>

  <!-- Who qualifies -->
  <section class="grid grid-cols-1 items-center gap-10 px-6 py-16 md:grid-cols-2 md:gap-14 md:px-24 md:py-24">
    <div class="reveal-left overflow-hidden rounded-2xl shadow-xl shadow-ink/15 sm:rounded-3xl sm:shadow-2xl">
      <img
        src="/images/women-in-program.jpg"
        alt="Women in the EWOP program at the unit"
        class="h-64 w-full object-cover sm:h-72 md:h-[420px]"
      />
    </div>
    <div class="reveal-right flex flex-col gap-4">
      <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Who qualifies</span>
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">Eligibility</h2>
      <ul class="flex flex-col gap-3">
        <li class="flex items-center gap-3 font-body text-base text-ink">
          <span class="flex h-[22px] w-[22px] items-center justify-center rounded-full bg-rose-tint text-xs font-bold text-rose">✓</span>
          Close to parole
        </li>
        <li class="flex items-center gap-3 font-body text-base text-ink">
          <span class="flex h-[22px] w-[22px] items-center justify-center rounded-full bg-rose-tint text-xs font-bold text-rose">✓</span>
          High school diploma or GED
        </li>
      </ul>
      <p class="font-body text-base leading-relaxed text-muted">
        Of roughly 1,100 applicants each cycle, about 80 women are chosen — and 89 of the program's 100 current
        participants are mothers.
      </p>
    </div>
  </section>

  <!-- History -->
  <section class="bg-gradient-to-b from-pink-wash-1 to-pink-wash-2 px-6 py-16 md:px-24 md:py-24">
    <div class="reveal mb-10 flex flex-col items-center gap-3 text-center">
      <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Where we come from</span>
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">Our history</h2>
      <p class="max-w-xl font-body text-base leading-relaxed text-muted">
        From a women's pilot in Lockhart to Aggie EWOP at Texas A&amp;M — the milestones that got us here.
      </p>
    </div>
    <div class="reveal">
      <HistoryTimeline />
    </div>
  </section>

  <!-- Faculty advisor -->
  <section class="grid grid-cols-1 items-center gap-8 px-6 py-16 md:grid-cols-[220px_1fr] md:gap-10 md:px-24 md:py-24">
    <img
      src={facultyAdvisor.photo}
      alt={facultyAdvisor.name}
      class="reveal-left h-40 w-40 rounded-full object-cover shadow-xl shadow-ink/10 md:h-[220px] md:w-[220px]"
      onerror="this.style.display='none'"
    />
    <div class="reveal-right flex flex-col gap-3">
      <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Faculty advisor</span>
      <h2 class="font-display text-3xl font-bold text-ink md:text-4xl">{facultyAdvisor.name}</h2>
      <p class="max-w-xl font-body text-base leading-relaxed text-muted">{facultyAdvisor.role}</p>
    </div>
  </section>
</BaseLayout>
