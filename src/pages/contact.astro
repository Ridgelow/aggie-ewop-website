---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { links } from '../data/links';
---

<BaseLayout title="Contact" description="Get in touch with Aggie EWOP.">
  <section class="animate-fadeUp grid grid-cols-1 gap-14 px-6 py-16 md:grid-cols-[1.1fr_1fr] md:gap-[72px] md:px-24 md:py-24">
    <div class="flex flex-col gap-6">
      <span class="font-body text-sm font-bold uppercase tracking-widest text-rose">Contact</span>
      <h1 class="font-display text-4xl font-extrabold leading-tight text-ink md:text-[44px]">We'd love to hear from you.</h1>
      <p class="max-w-md font-body text-lg leading-relaxed text-muted">
        Questions about membership, partnerships, or the program itself — reach out any time.
      </p>

      <div class="mt-2 flex flex-col gap-3.5">
        <a href={`mailto:${links.email}`} class="flex items-center gap-4 rounded-2xl border border-line bg-white p-5 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-ink/10">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-rose-tint">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E9267C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="M3 7l9 6 9-6"></path>
            </svg>
          </div>
          <div>
            <div class="font-body text-xs font-bold uppercase tracking-wide text-faint">Email</div>
            <div class="font-body text-base text-ink">{links.email}</div>
          </div>
        </a>
        <a href={links.instagramUrl} class="flex items-center gap-4 rounded-2xl border border-line bg-white p-5 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-ink/10">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-violet-tint">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#7B3F9E" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4.2"></circle>
              <circle cx="17.2" cy="6.8" r="0.6" fill="#7B3F9E" stroke="none"></circle>
            </svg>
          </div>
          <div>
            <div class="font-body text-xs font-bold uppercase tracking-wide text-faint">Instagram</div>
            <div class="font-body text-base text-ink">{links.instagramHandle}</div>
          </div>
        </a>
        <a href={links.linkedinUrl} class="flex items-center gap-4 rounded-2xl border border-line bg-white p-5 transition-all hover:-translate-y-1 hover:shadow-lg hover:shadow-ink/10">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-sky-tint">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#1C99C2" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="4"></rect><line x1="7.5" y1="10" x2="7.5" y2="17"></line>
              <circle cx="7.5" cy="6.7" r="0.9" fill="#1C99C2" stroke="none"></circle>
              <path d="M11.5 17v-4.2c0-1.6 1-2.6 2.4-2.6 1.3 0 2.1.9 2.1 2.6V17"></path><line x1="11.5" y1="10" x2="11.5" y2="17"></line>
            </svg>
          </div>
          <div>
            <div class="font-body text-xs font-bold uppercase tracking-wide text-faint">LinkedIn</div>
            <div class="font-body text-base text-ink">Aggie EWOP</div>
          </div>
        </a>
        <div class="flex items-center gap-4 rounded-2xl border border-line bg-white p-5">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-fundraising-tint">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#A31E63" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s-7-5.2-7-11a7 7 0 0 1 14 0c0 5.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.6"></circle>
            </svg>
          </div>
          <div>
            <div class="font-body text-xs font-bold uppercase tracking-wide text-faint">Meetings</div>
            <div class="font-body text-base text-ink">{links.meetingLocation}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="animate-fadeUp flex flex-col items-center justify-center gap-5 rounded-3xl bg-gradient-to-br from-ink to-ink2 p-11 text-center">
      <span class="font-body text-xs font-bold uppercase tracking-widest text-[#F49FC4]">Ready to join?</span>
      <h2 class="font-display text-2xl font-bold text-white">Scan for the 5-minute application</h2>
      <div class="w-fit rounded-2xl bg-white p-[18px]">
        <img src="/images/apply-qr.png" alt="QR code to apply" class="h-40 w-40" />
      </div>
      <Button href={links.applicationUrl}>Or apply online</Button>
    </div>
  </section>
</BaseLayout>
